@page "/VeganPlaceDuyLds/Index"
@model Vegan.RazorWebApp.DuyLD.Pages.VeganPlaceDuyLds.IndexModel

@{
    ViewData["Title"] = "Vegan Places";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Vegan Places</h1>
        <p class="text-muted mb-0">Manage vegan locations and their availability.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</div>

<form method="get" asp-page="./Index" class="row g-3 border rounded bg-light p-3 mb-4">
    <div class="col-md-4">
        <label asp-for="PlaceSearch" class="form-label">Place</label>
        <input asp-for="PlaceSearch" type="search" class="form-control" placeholder="Search by place name" />
    </div>
    <div class="col-md-4">
        <label asp-for="CategorySearch" class="form-label">Category</label>
        <input asp-for="CategorySearch" type="search" class="form-control" placeholder="Search by category" />
    </div>
    <div class="col-md-2">
        <label asp-for="IsActive" class="form-label">Status</label>
        <select asp-for="IsActive" class="form-select">
            <option value="">All</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">@Model.ResultCount result(s)</span>
</div>

<div class="table-responsive border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Place</th>
                <th>Category</th>
                <th>Contact</th>
                <th>Rating</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.VeganPlaceDuyLd.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No matching places.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.VeganPlaceDuyLd)
                {
                    <tr>
                        <td>@item.VeganPlaceDuyLdid</td>
                        <td>
                            <strong>@item.PlaceName</strong>
                            <div class="small text-muted">@item.Address</div>
                        </td>
                        <td>@item.CategoryName</td>
                        <td>
                            <div>@item.Phone</div>
                            @if (!string.IsNullOrWhiteSpace(item.Website))
                            {
                                <a class="small" href="@item.Website" target="_blank" rel="noopener noreferrer">Website</a>
                            }
                        </td>
                        <td>@(item.Rating?.ToString("0.0") ?? "N/A")</td>
                        <td>
                            <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="./Details" asp-route-id="@item.VeganPlaceDuyLdid" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-page="./Edit" asp-route-id="@item.VeganPlaceDuyLdid" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-page="./Delete" asp-route-id="@item.VeganPlaceDuyLdid" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Vegan place pagination">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                @if (Model.PageNumber > 1)
                {
                    <a class="page-link" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-PlaceSearch="@Model.PlaceSearch" asp-route-CategorySearch="@Model.CategorySearch" asp-route-IsActive="@Model.IsActive">Previous</a>
                }
                else
                {
                    <span class="page-link">Previous</span>
                }
            </li>
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(Model.PageNumber == pageNumber ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-PageNumber="@pageNumber" asp-route-PlaceSearch="@Model.PlaceSearch" asp-route-CategorySearch="@Model.CategorySearch" asp-route-IsActive="@Model.IsActive">@pageNumber</a>
                </li>
            }
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a class="page-link" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-PlaceSearch="@Model.PlaceSearch" asp-route-CategorySearch="@Model.CategorySearch" asp-route-IsActive="@Model.IsActive">Next</a>
                }
                else
                {
                    <span class="page-link">Next</span>
                }
            </li>
        </ul>
    </nav>
}

